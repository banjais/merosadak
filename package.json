{
  "name": "merosadak",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:static": "vite build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "ship": "node scripts/ship.cjs",
    "sync:data": "node worker/sync-data.js",
    "sync:kv:setup": "node worker/setup-kv.js",
    "worker:deploy": "node deploy-worker.cjs",
    "worker:tail": "cd worker && npx wrangler tail --config wrangler.toml",
    "deploy": "node deploy-worker.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/leaflet": "^1.9.22",
    "@vitejs/plugin-react": "^5.2.0",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "jspdf": "4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "vite": "^6.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "autoprefixer": "^10.5.5",
    "esbuild": "^0.25.12",
    "firebase": "^12.19.0",
    "papaparse": "^5.7.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "wrangler": "^4.135.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
