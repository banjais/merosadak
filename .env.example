# Mero Sadak — Environment Configuration
#
# This file documents required environment variables for both the
# Express dev server (server.ts) and the Cloudflare Worker.
#
# WARNING: Never commit real secrets to version control.
# Use `wrangler secret put` for Worker secrets, and secure vaults
# for server-side credentials.

# =============================================================================
# Cloudflare Worker Secrets (set via `wrangler secret put <NAME>`)
# =============================================================================

# --- Traffic & Incidents ---
# TOMTOM_API_KEY          Primary for /api/traffic + /api/incidents (2,500 free req/day)
# WAZE_FEED_URL           Fallback (requires Waze Partner Hub approval, not self-serve)

# --- Weather ---
# OPENWEATHERMAP_API_KEY  Fallback only (Open-Meteo is primary, free, no key)

# --- AI Assistant ---
# GEMINI_API_KEY          Required for /api/assistant

# --- Cache (optional) ---
# UPSTASH_REDIS_REST_URL  AI response cache
# UPSTASH_REDIS_REST_TOKEN

# --- DoR Road Closures ---
# DOR_GOOGLE_SHEET_URL    Google Sheet CSV export of Department of Roads closures
#                         (can also be set as a plain var in wrangler.toml)

# =============================================================================
# New Free / Generous Free-Tier APIs (optional fallbacks or enhancements)
# =============================================================================
# These improve reliability for Nepal road travel. All are optional.
# If unset, the app gracefully degrades to the next available source.

# --- Routing (alternative / fallback to OSRM) ---
# OPENROUTESERVICE_API_KEY   Free key from openrouteservice.org
#                            Good OSM-based routing, elevation, isochrones.
#                            Recommended as primary alternative to public OSRM.

# --- Geocoding / Search (fallback to Photon + Nominatim) ---
# LOCATIONIQ_API_KEY         Free tier ~5,000 req/day — locationiq.com
# OPENCAGE_API_KEY           Free tier ~2,500 req/day — opencagedata.com
#                            Either one improves rate limits and reliability.

# --- Air Quality (new feature, useful for Kathmandu & major cities) ---
# WAQI_API_KEY               Free key from aqicn.org / waqi.info
#                            Real-time AQI for Nepal cities.

# --- Elevation (mountain highways, road grades) ---
# No key required for public OpenTopoData instances.
# Can be called directly or proxied if needed.

# =============================================================================
# Cloudflare Worker Config (set in wrangler.toml [vars] or as secret)
# =============================================================================
# ALLOWED_ORIGIN             CORS allowed origin (e.g. https://merosadak.web.app)
# GEMINI_MODEL_PRIMARY       e.g. gemini-2.5-flash
# GEMINI_MODEL_SECONDARY     e.g. gemini-2.0-flash-lite

# =============================================================================
# Express Dev Server (.env, not committed)
# =============================================================================
# PORT                       Server port (default 3000)
# GEMINI_API_KEY             Same key as Worker (for local AI calls)
# VITE_WORKER_URL            Override worker base URL in development
# OPENROUTESERVICE_API_KEY   (optional, for local testing)
# LOCATIONIQ_API_KEY         (optional)
# OPENCAGE_API_KEY           (optional)
# WAQI_API_KEY               (optional)
