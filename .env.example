# ==========================
# Cloudflare KV (data sync)
# ==========================
# Create token at https://dash.cloudflare.com/profile/api-tokens
# Required permissions: Account > Workers KV Storage > Edit
CF_API_TOKEN=
CF_ACCOUNT_ID=

# ==========================
# Cloudflare Worker Secrets
# Set via: cd worker && npx wrangler secret put <NAME>
# ==========================
TOMTON_API_KEY=
OPENWEATHERMAP_API_KEY=
GEMINI_API_KEY=
WAZE_FEED_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ==========================
# Firebase (optional, if using service account locally)
# ==========================
FIREBASE_SERVICE_ACCOUNT_MEROSADAK=
