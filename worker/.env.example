# Do NOT put real values in this file or commit a filled-in .env.
# Set actual secrets on Cloudflare with:
#   cd worker
#   wrangler secret put <NAME>
#   wrangler deploy

# --- Traffic & incidents ---
# Primary source for /api/traffic and /api/incidents.
# Free tier: 2,500 requests/day. Get a key at developer.tomtom.com
TOMTOM_API_KEY=

# Fallback source for /api/traffic and /api/incidents when TomTom is
# missing or fails. NOT a self-serve free key — requires applying to
# the Waze Partner Hub / Waze for Cities program (waze.com/partner-hub),
# typically approved for government/transport authorities. Until this
# is set, the Waze fallback silently returns no results and traffic/
# incidents run on TomTom alone (or "source: none" if TomTom is also
# unset).
WAZE_FEED_URL=

# --- Weather ---
# Fallback for /api/weather, only called if Open-Meteo (free, no key,
# always tried first) fails. Free tier available at openweathermap.org/api
OPENWEATHERMAP_API_KEY=

# --- AI assistant (route safety advisory) ---
# Required for /api/assistant. Get a key at aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Assistant response cache (optional, best-effort) ---
# If unset, /api/assistant still works — it just calls Gemini fresh on
# every request instead of reusing a cached answer for 24h. Free tier
# at upstash.com (Redis REST API).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
